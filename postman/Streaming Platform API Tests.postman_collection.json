  "item": [
    {
      "name": "Messages",
      "item": [
        {
          "name": "Send message(valid)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response has message id\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"id\");",
                  "    ",
                  "    pm.environment.set(\"message_id\", json.id);",
                  "});",
                  "",
                  "pm.test(\"Response contains correct content\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.content).to.eql(\"Hello from Postman test\");",
                  "});",
                  "",
                  "pm.test(\"Response time is under 500ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"stream_id\": \"{{stream_id}}\",\n  \"content\": \"Hello from Postman test\",\n  \"user_id\": \"test-user-001\"\n}\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "messages"
              ]
            }
          },
          "response": []
